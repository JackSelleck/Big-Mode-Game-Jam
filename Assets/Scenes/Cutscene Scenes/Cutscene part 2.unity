PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 833732573210176472, guid: 541bbf424a499cd4c8a115d83957583d, type: 3}
      propertyPath: m_text
      value: 'Boss: You mean the ghosts? Oh, don''t worry about them, they''re past
        employees of mine, they were too lazy and died from exhaustion, what a useless
        bunch.


        Protagonist: ...what?


        Boss: Now, since you''re
        already here I guess you can start your shift then.


        Protagonist:
        ...I''ve been working for 14 consecutive hours.


        Boss: So?


        Protagonist:
        I''m going home...


        Boss: If you leave now, you''re fired!


        Protagonist:
        You can''t fire me without a valid reason.'
      objectReference: {fileID: 0}
