  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Boss: Shut it! I know for a fact that you''ve been wasting time! Whenever
    I see you you''re looking at your phone, eating lunch, or having that heart attack
    last month! You won''t stop lazying around!



    Protagonist: Sir, I don''t
    think having a heart attack counts as being lazy...



    Boss: I don''t pay
    you to retort! I should fire you where you stand! '
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c1c823ffbc1d0d84d825c8967baa5c0b, type: 2}
